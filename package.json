{
  "name": "fitt-calisthenics",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "dev": "next dev --hostname 0.0.0.0 --port 5173",
    "build": "next build --webpack && node scripts/build-service-worker.mjs",
    "build:preview": "node scripts/build-preview.mjs",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "next start --hostname 0.0.0.0 --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json",
    "test:db": "FITT_RUN_LIVE_DB_TESTS=1 vitest run src/server/training.live.test.ts src/server/auth.live.test.ts src/server/migrations.live.test.ts",
    "test:account": "FITT_RUN_LIVE_DB_TESTS=1 playwright test tests/account-live.spec.ts",
    "test:realtime": "node --test scripts/test-realtime.mjs",
    "test:email-worker": "node --test scripts/test-email-worker.mjs",
    "test:worker-account": "node --test scripts/test-worker-account.mjs",
    "dev:worker": "opennextjs-cloudflare preview",
    "check:deploy": "npm run build:worker && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy": "npm run build:worker && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:form-preview": "node scripts/build-preview.mjs --form"
  },
  "dependencies": {
    "@better-auth/core": "1.6.23",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@neondatabase/serverless": "1.2.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@react-email/render": "2.2.0",
    "@turnal-io/auth": "1.1.0",
    "@turnal-io/db": "1.0.1",
    "@turnal-io/email": "2.1.0",
    "better-auth": "1.6.23",
    "drizzle-orm": "0.45.4",
    "https-proxy-agent": "9.1.0",
    "lucide-react": "1.66.0",
    "next": "16.4.3",
    "nodemailer": "8.0.11",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "three": "0.187.0",
    "worker-mailer": "1.2.1",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261101.1",
    "@next/env": "16.4.3",
    "@opennextjs/cloudflare": "1.20.15",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.187.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "miniflare": "5.20261023.3-beta",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "wrangler": "4.156.0"
  }
}
