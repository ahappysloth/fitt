# Worker-local preview bindings, copied privately to .dev.vars (ignored).
# bun run preview overrides the built Worker's origin to 127.0.0.1:4173.
# Vite development uses port 5173. Never commit filled-in files.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:4173
TRUSTED_ORIGINS=http://127.0.0.1:4173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=smtp.purelymail.com
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
FITT_ADMIN_EMAILS=
