# Vite development; fill in .env.local (ignored), never this file.
# Cloudflare Worker deployment uses the same names as Worker secrets/vars.
# Values are managed with Envault (envault pull / envault edit). The `# @env` line above a key
# is its rule per environment: local = .env.local, preview = .dev.vars, prod = the deployed Worker.
# @env local=set preview=set prod=set
DATABASE_URL=
# @env local=set preview=set prod=set
BETTER_AUTH_SECRET=
# @env local=http://localhost:5173 preview=http://127.0.0.1:4173 prod=https://fitt.turnal.workers.dev
BETTER_AUTH_URL=http://localhost:5173
# @env local=http://localhost:5173 preview=http://127.0.0.1:4173 prod=https://fitt.turnal.workers.dev
TRUSTED_ORIGINS=http://localhost:5173
# @env local=any preview=any prod=set
GOOGLE_CLIENT_ID=
# @env local=any preview=any prod=set
GOOGLE_CLIENT_SECRET=

# PurelyMail, matching Juno: port 465 with implicit TLS.
# @env local=smtp.purelymail.com preview=smtp.purelymail.com prod=smtp.purelymail.com
SMTP_HOST=smtp.purelymail.com
# @env local=any preview=any prod=set
SMTP_USER=
# @env local=any preview=any prod=set
SMTP_PASS=
# @env local=any preview=any prod=set
EMAIL_FROM=

# Optional, server-only administrator allowlist (comma-separated verified emails).
# Leave blank to hide and disable the private design/model studios.
# @env local=any preview=any prod=any
FITT_ADMIN_EMAILS=

# Generate a Fitt-specific signing secret with: openssl rand -base64 32
# Google redirect: <BETTER_AUTH_URL>/api/auth/callback/google
# Keep GITHUB_PACKAGES_TOKEN in shell/environment setup for private npm installs.
# SMTP requires direct socket access. Use the deployed preview for email delivery
# when the local environment restricts outbound network access to an HTTP proxy.
